# Database
DATABASE_URL=postgresql://moments:moments_dev@localhost:5432/moments

# Auth
JWT_SECRET=change_me_to_a_32_plus_char_random_string
TENCENT_COS_SECRET_ID=your_cos_secret_id
TENCENT_COS_SECRET_KEY=your_cos_secret_key

# App
STORAGE_CONFIG_FILE=config/storage.json
NODE_ENV=development
PORT=3000

# Admin
# Comma-separated list of admin usernames (case-insensitive)
ADMIN_USERNAMES=admin

# Media Cleanup
# MEDIA_CLEANUP_ENABLED=true
# MEDIA_CLEANUP_DRY_RUN=false
# MEDIA_CLEANUP_RETENTION_DAYS=7
# MEDIA_CLEANUP_PENDING_MAX_AGE_HOURS=24
# MEDIA_CLEANUP_BATCH_SIZE=100
