{
  "storage": {
    "driver": "tencent-cos",
    "signedUrlTtlSeconds": 604800,
    "keyPrefix": "moments",
    "ci": {
      "enabled": false,
      "feedImage": "imageMogr2/thumbnail/800x/format/webp/quality/80",
      "feedCover": "imageMogr2/thumbnail/800x/format/webp/quality/80",
      "smallThumb": "imageMogr2/thumbnail/200x200/format/webp/quality/80",
      "avatar": "imageMogr2/thumbnail/200x200/format/webp/quality/85",
      "spaceCover": "imageMogr2/thumbnail/800x/format/webp/quality/80"
    },
    "tencentCos": {
      "secretId": "${TENCENT_COS_SECRET_ID}",
      "secretKey": "${TENCENT_COS_SECRET_KEY}",
      "region": "ap-shanghai",
      "bucket": "your-bucket-1250000000",
      "useHttps": true,
      "timeoutMs": 30000
    }
  }
}
